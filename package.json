{
  "name": "capi-studio",
  "version": "0.1.0",
  "description": "Capi Studio — Laser Production Art Studio",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsc --project tsconfig.node.json && concurrently --kill-others \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "build": "tsc --project tsconfig.node.json && vite build",
    "preview": "vite preview",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "konva": "^9.3.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.capilaser.studio",
    "productName": "Capi Studio",
    "directories": {
      "output": "dist-electron"
    }
  }
}
